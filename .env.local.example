# Supabase — a new, separate project from the commercial dashboard's.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Monday.com — migration script only (scripts/migrate-monday.ts).
MONDAY_TOKEN=
MONDAY_BOARD_ID=9613941689

# CRM's own machine-to-machine API auth (bearer, analogous to the
# dashboard's CRON_SECRET) — the dashboard and future automations
# authenticate to /api/v1/* with this.
CRM_API_TOKEN=

# Optional — scripts/seed-test-users.ts. Defaults to TrocarSenha123! if unset.
# SEED_TEST_USER_PASSWORD=

# Google Calendar ("Marcar reunião") — creating the event needs no env vars:
# it opens a pre-filled Google Calendar "create event" link
# (lib/google-calendar-link.ts) in a new tab, using whichever Google
# account the SDR is logged into in their browser. A Service Account
# approach was tried first, but a bare one can't invite attendees at all
# (Google 403s with "forbiddenForServiceAccounts"), and fixing that needs
# Domain-Wide Delegation, which requires Google Workspace + admin setup —
# the link needs none of that.
#
# Suggesting free time slots (lib/google-calendar-availability.ts) is a
# *read*, not a write, so it doesn't hit that restriction — it DOES need
# these two, the same Service Account credentials from the abandoned write
# attempt, reused for a read this account is actually allowed to do: each
# closer individually shares their own Google Calendar with this service
# account's email (free/busy visibility is enough, no admin needed). No
# GOOGLE_IMPERSONATE_EMAIL needed here — that was only for the abandoned
# Domain-Wide Delegation write path.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# "Enviar e-mail de primeiro contato" (lib/email-templates/
# primeiro-contato.ts) — sent via Resend (lib/adapters/resend.ts, same
# RESEND_API_KEY/RESEND_FROM_EMAIL as "Avisar inscritos" below), signed as
# "José Matheus" in the From display name even though the address is the
# shared contato@scalecompany.com.br. Used to send via Gmail SMTP
# (GMAIL_USER/GMAIL_APP_PASSWORD) from the operator's personal inbox —
# retired once contato@scalecompany.com.br became the official sender.
# JOSE_WHATSAPP_NUMBER completes the "Falar com José Matheus" button in the
# email template (format: "55DDDNUMERO", digits only, no symbols).
# JOSE_WHATSAPP_NUMBER=

# Not needed yet (Phase 1.5+, stubbed behind lib/adapters/*.ts):
# ZAPSIGN_*, META_CAPI_TOKEN, UPSTASH_REDIS_*

# Evolution API (lib/adapters/whatsapp.ts) — sends the "novo lead" WhatsApp
# group notification from the site webhooks below. Without these, the
# adapter falls back to a stub that just logs instead of sending.
# Self-hosted, so EVOLUTION_API_URL is your own server (e.g.
# https://evolution.seudominio.com.br), not a fixed provider domain.
# EVOLUTION_INSTANCE is the instance name (distinct from the API key) and
# EVOLUTION_API_KEY is that instance's token — both from your Evolution
# API panel.
# EVOLUTION_LEADS_GROUP_JID is the target group's JID (format
# "<id>@g.us") — get it from the /group/fetchAllGroups endpoint or your
# panel after adding the instance's number to the group.
# EVOLUTION_API_URL=
# EVOLUTION_INSTANCE=
# EVOLUTION_API_KEY=
# EVOLUTION_LEADS_GROUP_JID=

# Site webhooks (app/api/v1/webhooks/{blog,cases,contato}/route.ts) — the
# institutional site's backend sends this in an `X-Webhook-Token` header.
# Deliberately separate from CRM_API_TOKEN (which is full admin/service-role)
# since these endpoints are public-facing and only need "create a lead".
# Generate any long random string, e.g. `openssl rand -hex 32`.
# WEBHOOK_SITE_TOKEN=

# Resend (lib/adapters/resend.ts) — sends both "Avisar inscritos"
# (lib/actions/subscribers.ts, mass mail to Cases/Newsletter subscribers)
# and "Enviar e-mail de primeiro contato" (lib/actions/leads.ts). Official
# sender is contato@scalecompany.com.br — that domain is verified under
# Resend > Domains, so real sends from it work (not just the
# onboarding@resend.dev sandbox address). RESEND_API_KEY from
# resend.com/api-keys.
# CRM_PUBLIC_URL builds the unsubscribe link embedded in every send —
# defaults to https://crm.scalecompany.com.br if unset.
# UNSUBSCRIBE_SECRET signs that link (HMAC) so nobody can unsubscribe an
# email that isn't theirs by guessing the URL — dedicated secret, not reused
# from CRM_API_TOKEN/WEBHOOK_SITE_TOKEN, same reasoning as those two.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# CRM_PUBLIC_URL=
# UNSUBSCRIBE_SECRET=
